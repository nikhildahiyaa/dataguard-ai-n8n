{
  "name": "DataGuard AI \u2014 Daily Data Quality Check",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Vancouver"
  },
  "nodes": [
    {
      "parameters": {},
      "id": "manual-start",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -520,
        160
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "daily-start",
      "name": "Daily at 8 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -520,
        -40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/validate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({snapshot_date:null}) }}",
        "options": {}
      },
      "id": "validate",
      "name": "Validate Latest Snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -260,
        60
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "issue-rule",
              "leftValue": "={{ $json.status }}",
              "rightValue": "issues_found",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "branch",
      "name": "Any Issues?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        0,
        60
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/alerts",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({run_id:$json.run_id,snapshot_date:$json.snapshot_date,status:$json.status,issues:$json.issues}) }}",
        "options": {}
      },
      "id": "save-alert",
      "name": "Persist Alert Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        -40
      ]
    },
    {
      "parameters": {},
      "id": "no-issues",
      "name": "No Issues (Done)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        260,
        160
      ]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Validate Latest Snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Daily at 8 AM": {
      "main": [
        [
          {
            "node": "Validate Latest Snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Latest Snapshot": {
      "main": [
        [
          {
            "node": "Any Issues?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any Issues?": {
      "main": [
        [
          {
            "node": "Persist Alert Event",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Issues (Done)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
